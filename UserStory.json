      "rules": [
        {
          "id": "STATUS-RULE-001",
          "name": "العلاقة بين المستخدمين",
          "description": "تظهر الحالة فقط إذا كان الطرفان مسجلين لبعضهما في جهات الاتصال، مع مراعاة إعدادات خصوصية الحالة."
        },
        {
          "id": "STATUS-RULE-002",
          "name": "مدة الحالة",
